{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "node_modules/pdfkit/js/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/s/:slug", "destination": "/session.html" },
    { "source": "/panel/:slug", "destination": "/instructor.html" }
  ]
}
